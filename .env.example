# ============================================================
# Application settings
# ============================================================
NODE_ENV=development
# Port where the HTTP server listens
PORT=3000
# Public path where the Scalar API reference is served
DOCS_PATH=docs

# ============================================================
# Database settings
# ============================================================
# Storage backend. Currently supported values:
#   postgres  -> local/remote PostgreSQL instance
# (Future: supabase | firebase -> implement the repository adapter
#  and swap this value. See /src/modules/user-profile/infrastructure)
DATABASE_PROVIDER=postgres
# These are consumed by the PostgreSQL adapter only.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=reading_platform
# Auto-sync the schema on boot (dev only). Set to false and use migrations
# for anything that needs a controlled/versioned schema (CI, staging, prod).
DB_SYNCHRONIZE=true
# Apply pending migrations automatically at boot. Use this instead of
# DB_SYNCHRONIZE when you want migrations to run with the app startup.
DB_MIGRATIONS_RUN=false
# Enable SSL for the database connection (required by Supabase and most
# managed PostgreSQL providers).
DB_SSL=false