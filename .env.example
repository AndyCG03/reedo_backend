# ============================================================
# Application settings
# ============================================================
NODE_ENV=development
# Port where the HTTP server listens
PORT=3000
# Public path where the Scalar API reference is served
DOCS_PATH=docs

# ============================================================
# Database settings (Prisma ORM)
# ============================================================
# Prisma 7 reads the connection from environment variables, not from the
# schema file:
#   - DATABASE_URL -> runtime connection used by Prisma Client (via the
#                     `pg` driver adapter configured in PrismaService)
#   - DIRECT_URL   -> connection used by the Prisma CLI for migrations
#                     (prisma.config.ts); required when the runtime URL goes
#                     through a pooler (pgBouncer), like Supabase.
#
# Use ONE of the two blocks below.
#
# ---------- LOCAL (local PostgreSQL, e.g. `docker compose up -d`) ----------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reading_platform"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/reading_platform"

# ---------- DEV/PROD (Supabase via pooler) ----------
# Runtime — shared transaction-mode pooler (used by Prisma Client)
# DATABASE_URL="postgresql://postgres.ugdzowwbersiwwscvwnu:TU_PASSWORD_SUPABASE@aws-0-ca-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations — shared session-mode pooler (used by `prisma migrate`)
# DIRECT_URL="postgresql://postgres.ugdzowwbersiwwscvwnu:TU_PASSWORD_SUPABASE@aws-0-ca-central-1.pooler.supabase.com:5432/postgres"